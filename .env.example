# ReplyFlow local configuration template
# Copy this file to .env only when Interactive Mode is implemented.

# Coze CN OpenAPI base URL. If the project later moves to the international
# workspace, replace this value with the base URL shown by that workspace.
COZE_API_BASE_URL=https://api.coze.cn/v1

# Coze Personal Access Token (PAT). Never commit a real token.
COZE_API_TOKEN=

# Published Coze Workflow ID used by Interactive Mode.
COZE_WORKFLOW_ID=

# Human-readable published version for trace and evaluation records. The API
# call is still keyed by COZE_WORKFLOW_ID unless Coze changes its contract.
COZE_WORKFLOW_VERSION=

COZE_TIMEOUT_SECONDS=30

# Local demo database path. Keep this inside the ignored runtime-data area.
REPLYFLOW_DB_PATH=data/local/replyflow.sqlite3
