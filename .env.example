# ReplyFlow local configuration template
# Copy this file to .env only when Interactive Mode is implemented.

# Dify Cloud or self-hosted API base URL, for example:
# DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_BASE_URL=

# Never commit a real API key.
DIFY_API_KEY=

# Optional Dify application/workflow identifier, if the selected integration requires it.
DIFY_APP_ID=

# Local demo database path. Keep this inside the ignored runtime-data area.
REPLYFLOW_DB_PATH=data/local/replyflow.sqlite3
